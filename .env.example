# Copy to .env and fill in. With no Supabase values the app runs in local demo mode (data/db.json).
PORT=3000

# --- Supabase (primary database). Run supabase/schema.sql in the Supabase SQL editor first. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=manuals

# --- On-premise PostgreSQL mirror (optional). Example: postgres://erp:secret@192.168.1.10:5432/wellops ---
ONPREM_PG_URL=
# Minutes between automatic syncs. 0 = manual only (Settings > Data Sync, or `npm run sync`).
SYNC_INTERVAL_MIN=0

# --- Security ---
SESSION_SECRET=
# Role-picker login without password. Leave true only for demos; set false in production.
DEMO_LOGIN=true
# Password given to the seeded users on first start.
SEED_PASSWORD=ChangeMe-2026

# --- Field VPN (optional). Deep link / URL opened on the device after a successful face login,
#     e.g. a WireGuard/OpenVPN client URL scheme or a local agent endpoint. ---
VPN_CONNECT_URL=
