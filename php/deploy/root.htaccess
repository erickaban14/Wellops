# ProStars on Apache (InfinityFree). Lives in htdocs/.
# Never serve configuration, installer leftovers or internal folders.
<FilesMatch "^(config(\.sample)?\.php|installed\.lock|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    # The host caches static files for 30 days; make browsers revalidate app files so updates show up.
    # (The service worker still serves assets from its own cache, so this costs few hits.)
    <FilesMatch "\.(html|js|css|json|webmanifest)$">
        Header set Cache-Control "no-cache"
        Header unset Expires
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # app/ and uploads/ are closed off by their own .htaccess; block them here too.
    RewriteRule ^(app|uploads)(/|$) - [F,L]
    # API
    RewriteRule ^api(/|$) api/index.php [L]
    # Single-page app: anything that is not a real file goes to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
